# Copy to .env for local development. Never commit .env (.gitignore covers it).
# Every value here is a placeholder; real credentials are injected by the deployment environment.
#
# Both commands read .env at start-up and set only the variables the
# environment has not already set, so an explicit export still wins and a
# deployment that ships no file is unaffected. Set ENV_FILE to read a
# different file. Quote any value that contains " #", since an unquoted hash
# preceded by a space opens a comment.

# ---- Application ----
APP_ENV=development            # development | staging | production
APP_PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error
APP_SHUTDOWN_TIMEOUT=15s

# ---- HTTP hardening ----
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576    # 1 MiB cap on inbound request bodies

# ---- PostgreSQL (configuration, routing, credentials, idempotency) ----
DATABASE_URL=postgres://gluzo:gluzo@localhost:5432/gluzo_gateway?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s

# ---- Redis (job queue) ----
REDIS_URL=redis://localhost:6379/0
# Optional; overrides any password in REDIS_URL. Prefer it over embedding the
# password in the URL, where reserved characters must be percent-encoded and
# a mistake surfaces as an authentication failure rather than a parse error.
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=5s

# ---- Job queue (Redis Streams) ----
QUEUE_STREAM=gluzo:jobs
QUEUE_GROUP=gateway-workers
QUEUE_BATCH_SIZE=10
QUEUE_BLOCK_TIMEOUT=5s
QUEUE_CLAIM_MIN_IDLE=60s       # unacknowledged jobs older than this are reclaimed from dead workers
QUEUE_MAX_DELIVERIES=5         # deliveries before a job is moved to the dead-letter stream
QUEUE_MAX_LEN=100000

# ---- Worker (executes queued workflows in this process) ----
WORKER_ENABLED=true            # false runs an API-only instance
WORKER_CONCURRENCY=4
WORKER_MAX_AUTO_RESUMES=3      # automatic resumes of a failed run with a retryable error
WORKER_RECOVERY_INTERVAL=5m
WORKER_STALE_RUNNING_AFTER=10m
WORKER_RETRY_FAILED_AFTER=1m

# ---- Scheduler (periodic stock and dispatch sweeps) ----
# A dropship vendor cannot call us, so periodic work is pulled. Disable on an
# intake-only instance. No job is registered yet; see docs/phases/.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=30s    # how often due jobs are looked for, not a job's interval
SCHEDULER_LOCK_TTL=5m          # must exceed a normal run and stay under the shortest interval
STOCK_SYNC_INTERVAL=15m        # how often changed vendor stock is pushed to EasyEcom
STOCK_SYNC_FULL_INTERVAL=24h   # how often every SKU is pushed, repairing any drift
SHIPMENT_SYNC_INTERVAL=15m     # how often dispatch records are read from the vendor
SHIPMENT_SYNC_MAX_WINDOW=24h   # cap on one run's period, so a backlog drains in chunks
RECONCILE_INTERVAL=1h          # how often to look for work that stopped progressing
RECONCILE_THRESHOLD=30m        # how long a run may sit untouched before it is reported;
                               # must exceed WORKER_RETRY_FAILED_AFTER

# ---- Vinculum / BCPL (outbound API calls made by the worker) ----
# Read paths only so far; no workflow calls them yet. See
# docs/vinculum-integration-plan.md. Leave blank on an intake-only instance.
VINCULUM_BASE_URL=https://erp.vineretail.com
VINCULUM_API_OWNER=            # ApiOwner header, issued by BCPL
VINCULUM_API_KEY=              # ApiKey header, issued by BCPL
VINCULUM_LOCATION=             # three-character orderLocation code for BCPL's warehouse
VINCULUM_SELLABLE_BUCKET=      # bucket value that represents good, sellable stock; blank accepts every bucket
VINCULUM_TIMEOUT=20s
VINCULUM_ORDER_RATE_LIMIT=80    # documented ceiling on order creation
VINCULUM_ORDER_RATE_WINDOW=5m   # ...per this window
VINCULUM_DUPLICATE_ORDER_CODES= # comma-separated responseCode values meaning "order already exists"

# ---- EasyEcom (outbound API calls made by the worker) ----
EASYECOM_BASE_URL=https://api.easyecom.io
EASYECOM_API_KEY=              # X-API-Key from EasyEcom account settings
EASYECOM_JWT_TOKEN=            # either a pre-issued JWT...
EASYECOM_EMAIL=                # ...or login credentials used to obtain one
EASYECOM_PASSWORD=
EASYECOM_LOCATION_KEY=
EASYECOM_TIMEOUT=15s
# Delivery statuses as EasyEcom numbers them, e.g. SHIPPED=3,IN_TRANSIT=4,DELIVERED=7.
# Unset statuses are not pushed: dispatch details are still assigned, so the
# customer gets a tracking number, but the delivery status is left alone
# rather than guessed.
EASYECOM_SHIPMENT_STATUS_IDS=

# ---- File storage (execution logs and workflow state) ----
LOG_DIRECTORY=./storage/logs
WORKFLOW_DIRECTORY=./storage/workflows
LOG_RETENTION_DAYS=30
LOG_RETENTION_INTERVAL=1h      # how often expired log days, idempotency records and completed state are pruned

# ---- Admin log viewer (GET /admin/logs) ----
ADMIN_LOG_VIEWER_TOKEN=        # leave empty to disable the admin endpoints entirely
